{
  "name": "best-technology-web",
  "version": "1.0.0",
  "private": true,
  "description": "Best Technology IT Solution - Integrated Electronic Security Solutions & Professional IT Integration",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 NODE_OPTIONS=\"--max-old-space-size=4096\" max build",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" max build",
    "deploy": "npm run build",
    "dev": "npm run start:dev",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "npm run lint:js && npm run lint:prettier && npm run tsc",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src ",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && max preview --port 8000",
    "start": "max setup && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" UMI_ENV=dev max dev",
    "start:dev": "max setup && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^4.8.0",
    "@ant-design/pro-components": "^2.3.57",
    "antd": "^5.5.0",
    "atob": "^2.1.2",
    "html2canvas": "^1.4.1",
    "lodash": "^4.17.21",
    "pdfjs-dist": "3.11.174",
    "react": "^18.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.2.0",
    "react-icons": "^4.8.0",
    "react-pdf": "^8.0.2",
    "styled-components": "6.0.0-beta.9",
    "swiper": "^9.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/lodash": "^4.14.191",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@umijs/lint": "^4.0.52",
    "@umijs/max": "^4.0.59",
    "cross-env": "^7.0.3",
    "eslint": "^8.34.0",
    "jest": "^29.4.3",
    "jest-environment-jsdom": "^29.4.3",
    "prettier": "^2.8.4",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "umi-presets-pro": "^2.0.2"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "create-umi": {
    "ignoreScript": [
      "docker*",
      "functions*",
      "site",
      "generateMock"
    ],
    "ignoreDependencies": [
      "netlify*",
      "serverless"
    ],
    "ignore": [
      ".dockerignore",
      ".git",
      ".github",
      ".gitpod.yml",
      "CODE_OF_CONDUCT.md",
      "Dockerfile",
      "Dockerfile.*",
      "lambda",
      "LICENSE",
      "netlify.toml",
      "README.*.md",
      "azure-pipelines.yml",
      "docker",
      "CNAME",
      "create-umi"
    ]
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
